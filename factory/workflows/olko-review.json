{
  "name": "olko-review",
  "version": "0.1.0",
  "entry": "scope",
  "nodes": [
    {
      "id": "scope",
      "kind": "script",
      "run": "gh pr view + gh pr diff"
    },
    {
      "id": "detect",
      "kind": "script",
      "run": "map changed paths to lenses"
    },
    {
      "id": "memory",
      "kind": "script",
      "run": "olko-memory-layer (not loaded in the PoC)"
    },
    {
      "id": "lenses",
      "kind": "llm",
      "role": "lens",
      "agentsFrom": "state.detect.lenses"
    },
    {
      "id": "merge",
      "kind": "script",
      "run": "drop duplicates by path:line + rule-id"
    },
    {
      "id": "verify",
      "kind": "llm",
      "role": "verifier",
      "agent": "olko-review-verifier"
    },
    {
      "id": "rank",
      "kind": "script",
      "run": "rank bug > security > repo-rule > design > style > nit, write report"
    }
  ],
  "edges": [
    {
      "from": "scope",
      "to": "detect"
    },
    {
      "from": "detect",
      "to": "memory"
    },
    {
      "from": "memory",
      "to": "lenses"
    },
    {
      "from": "lenses",
      "to": "merge"
    },
    {
      "from": "merge",
      "to": "verify",
      "when": "merge.findings > 0"
    },
    {
      "from": "merge",
      "to": "rank",
      "when": "merge.findings == 0"
    },
    {
      "from": "verify",
      "to": "rank"
    },
    {
      "from": "rank",
      "to": "END"
    }
  ]
}
