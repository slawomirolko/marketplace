{
  "name": "skill-factory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "server": "node src/server.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:scenario": "node test/scenario.ts",
    "viewer": "pnpm --dir app run dev",
    "viewer:build": "pnpm --dir app run build",
    "viewer:mermaid": "node viewer/render.ts",
    "setup": "node setup.ts",
    "bundle": "vite build --config bundle.config.ts",
    "build": "pnpm run viewer:build && pnpm run bundle",
    "stdio": "node src/stdio.ts",
    "clean:tmp": "node src/clean-tmp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mustache": "4.2.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
