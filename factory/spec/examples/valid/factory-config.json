{
  "schemaVersion": 1,
  "tiers": ["low", "medium", "high"],
  "backends": [
    { "id": "claude-cli", "kind": "cli", "cli": "claude", "discovery": "ask_user" },
    { "id": "opencode-cli", "kind": "cli", "cli": "opencode", "discovery": "list_models" },
    { "id": "host", "kind": "harness" },
    { "id": "host-subagent", "kind": "delegate" },
    { "id": "direct-api", "kind": "api", "protocol": "anthropic", "apiKeyEnv": "ANTHROPIC_API_KEY", "discovery": "list_models" }
  ],
  "roles": {
    "planner": "high",
    "implementer": "medium",
    "reviewer": "medium",
    "accountant": "low"
  },
  "budget": { "maxCostUsd": 20, "infoRatio": 0.5, "pauseRatio": 0.8, "onExceeded": "ask_user" }
}
