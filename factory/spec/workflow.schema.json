{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow.schema.json",
  "title": "Factory workflow",
  "description": "A graph owned by the factory, written in YAML (workflows/*.yaml). Clients never send it; they name it at most.",
  "type": "object",
  "required": [
    "name",
    "version",
    "entry",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "entry": {
      "$ref": "#/$defs/id"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxCycleIterations": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "maxTurnsPerNode": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "The marketplace agent or document this workflow implements."
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "description": "Role-to-tier defaults of this workflow; the user can change them at confirmation."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q-[a-z0-9-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "llm",
            "script",
            "interrupt",
            "subgraph",
            "map"
          ]
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "$ref": "#/$defs/id"
        },
        "over": {
          "type": "string",
          "pattern": "^state\\.[a-zA-Z0-9_.]+$"
        },
        "question": {
          "$ref": "#/$defs/question"
        },
        "outputSchema": {
          "type": "string",
          "minLength": 1
        },
        "maxTurns": {
          "type": "integer",
          "minimum": 1
        },
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/agent"
          },
          "description": "Agents that run this node one after another; each one is priced on its own. role overrides the node role."
        },
        "agent": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Harness agent that runs this node, for example an OpenCode agent from agents/opencode."
        },
        "agentsFrom": {
          "type": "string",
          "pattern": "^state.[a-zA-Z0-9_.]+$",
          "description": "Agents chosen at run time from state; each one is priced on its own."
        },
        "op": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*.[a-z][a-zA-Z0-9]*$",
          "description": "Named factory operation that a script node runs."
        },
        "with": {
          "type": "object",
          "description": "Arguments for the operation."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "description": "Mustache template. Context: goal, input, state, agent, answer, steps."
        },
        "parse": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*.[a-z][a-zA-Z0-9]*$",
          "description": "Named parser that turns the agent output into state."
        },
        "turns": {
          "type": "integer",
          "minimum": 1,
          "description": "Model turns of the node for the fake test model."
        },
        "askAfterTurn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "llm"
              }
            }
          },
          "then": {
            "required": [
              "role",
              "prompt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "op"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "interrupt"
              }
            }
          },
          "then": {
            "required": [
              "question"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "subgraph"
              }
            }
          },
          "then": {
            "required": [
              "workflow"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "map"
              }
            }
          },
          "then": {
            "required": [
              "over",
              "workflow"
            ]
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "const": "END"
            }
          ]
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "description": "Condition over validated state fields only, never over prose."
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
